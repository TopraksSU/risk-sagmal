@dataclass
class AnalysisResult:
    risk: pd.DataFrame
    summary: Dict[str, object]
    lactation: pd.DataFrame
    reproduction: pd.DataFrame
    methodology: pd.DataFrame


def _detect_separator(text: str) -> str:
    sample = text[:8192]
    try:
        return csv.Sniffer().sniff(sample, delimiters=";,\t").delimiter
    except csv.Error:
        first = sample.splitlines()[0] if sample else ""
        return ";" if first.count(";") > first.count(",") else ","


def _read_csv_text(text: str) -> pd.DataFrame:
    sep = _detect_separator(text)
    return pd.read_csv(
        io.StringIO(text), sep=sep, dtype=str, keep_default_na=False,
        na_values=[], on_bad_lines="skip",
    )


def _num(s: pd.Series) -> pd.Series:
    if s is None:
        return pd.Series(dtype=float)
    x = s.astype(str).str.strip()
    both = x.str.contains(r"\.", regex=True) & x.str.contains(",", regex=False)
    comma_decimal = both & (x.str.rfind(",") > x.str.rfind("."))
    x.loc[comma_decimal] = x.loc[comma_decimal].str.replace(".", "", regex=False).str.replace(",", ".", regex=False)
    x.loc[both & ~comma_decimal] = x.loc[both & ~comma_decimal].str.replace(",", "", regex=False)
    x.loc[~both] = x.loc[~both].str.replace(",", ".", regex=False)
    return pd.to_numeric(x, errors="coerce")


def _scalar_num(v) -> Optional[float]:
    if v is None or (isinstance(v, float) and math.isnan(v)):
        return None
    s = str(v).strip()
    if not s:
        return None
    if "." in s and "," in s:
        s = s.replace(".", "").replace(",", ".") if s.rfind(",") > s.rfind(".") else s.replace(",", "")
    else:
        s = s.replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def _bool_scalar(v) -> Optional[bool]:
    if v is None:
        return None
    s = str(v).strip().casefold()
    if not s:
        return None
    if s in {"true", "1", "yes", "evet", "ok", "success", "successful"}:
        return True
    if s in {"false", "0", "no", "hayır", "hayir", "failed", "failure"}:
        return False
    return None


def _bool_series(s: pd.Series) -> pd.Series:
    return s.astype(str).str.strip().str.casefold().map({
        "true": True, "1": True, "yes": True, "evet": True, "ok": True,
        "false": False, "0": False, "no": False, "hayır": False, "hayir": False,
    })


def _time_minutes(v) -> Optional[float]:
    if v is None:
        return None
    s = str(v).strip()
    if not s:
        return None
    parts = s.split(":")
    if len(parts) in (2, 3) and all(p.replace(".", "", 1).isdigit() for p in parts):
        try:
            h, m = float(parts[0]), float(parts[1])
            sec = float(parts[2]) if len(parts) == 3 else 0.0
            return h * 60 + m + sec / 60
        except ValueError:
            pass
    x = _scalar_num(v)
    if x is None:
        return None
    if 0 <= x < 1:
        return x * 1440
    if x > 1000:
        return (x - math.floor(x)) * 1440
    if x > 24:
        return x
    return x * 60


def _drop(current: Optional[float], baseline: Optional[float]) -> Optional[float]:
    if current is None or baseline is None or baseline <= 0:
        return None
    return max(0.0, (baseline - current) / baseline)


def _increase(current: Optional[float], baseline: Optional[float]) -> Optional[float]:
    if current is None or baseline is None or baseline <= 0:
        return None
    return max(0.0, (current - baseline) / baseline)


def _scaled(value: Optional[float], threshold: float) -> Optional[float]:
    if value is None:
        return None
    return min(100.0, max(0.0, value / threshold * 100.0))


def _weighted_available(parts: Iterable[Tuple[Optional[float], float]]) -> Tuple[Optional[float], float]:
    used = [(v, w) for v, w in parts if v is not None and not (isinstance(v, float) and math.isnan(v))]
    total_all = sum(w for _, w in parts)
    total_used = sum(w for _, w in used)
    if not used or total_used <= 0:
        return None, 0.0
    score = sum(v * w for v, w in used) / total_used
    coverage = 100.0 * total_used / total_all if total_all else 0.0
    return score, coverage


def _required(df: pd.DataFrame, cols: List[str], label: str) -> None:
    missing = [c for c in cols if c not in df.columns]
    if missing:
        raise ValueError(f"{label} dosyasında gerekli sütun(lar) eksik: {', '.join(missing)}")


def _row_for(df: pd.DataFrame, key_col: str, animal: int) -> Optional[pd.Series]:
    sub = df[df[key_col] == animal]
    return None if sub.empty else sub.iloc[0]


def _period_mean(sub: pd.DataFrame, col: str, days: set[date]) -> Optional[float]:
    if col not in sub.columns:
        return None
    x = sub.loc[sub["__date"].isin(days), col]
    x = pd.to_numeric(x, errors="coerce").dropna()
    return None if x.empty else float(x.mean())


def _period_rate_any(sub: pd.DataFrame, cols: List[str], days: set[date]) -> Optional[float]:
    cols = [c for c in cols if c in sub.columns]
    if not cols:
        return None
    d = sub[sub["__date"].isin(days)]
    if d.empty:
        return None
    available = pd.DataFrame({c: _bool_series(d[c]) for c in cols})
    valid = available.notna().any(axis=1)
    if not valid.any():
        return None
